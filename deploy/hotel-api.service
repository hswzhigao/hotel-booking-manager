# hhao1121 API systemd 服务 — 放置到服务器 /etc/systemd/system/hotel-api.service
[Unit]
Description=hhao1121 hotel booking API
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/hhao1121/server
ExecStart=/usr/bin/node src/index.js
EnvironmentFile=/opt/hhao1121/server/.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
